[Unit]
Description=Ads Recovery diagnostics
After=network.target
[Service]
DynamicUser=yes
StateDirectory=ads-recovery
WorkingDirectory=/opt/ads-recovery
ExecStart=/usr/bin/python3 /opt/ads-recovery/server.py
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=96M
CPUQuota=10%
UMask=0077
[Install]
WantedBy=multi-user.target
